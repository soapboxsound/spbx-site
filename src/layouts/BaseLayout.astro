---
import Ambient from '../components/Ambient.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteNav from '../components/SiteNav.astro';
import {
  CONTACT_EMAIL,
  GOOGLE_SITE_VERIFICATION,
  ORG_NAME,
  SITE_DESCRIPTION,
  SITE_NAME,
  SITE_TAGLINE,
  SITE_URL,
} from '../consts';
import '../styles/brand-tokens.css';
import '../styles/theme.css';
import '../styles/hub.css';
import '../styles/site.css';

interface Props {
  title?: string;
  description?: string;
  /** Path for canonical, e.g. "/" or "/product" */
  path?: string;
  ogType?: 'website' | 'article';
}

const {
  title,
  description = SITE_DESCRIPTION,
  path = '/',
  ogType = 'website',
} = Astro.props;

const pageTitle = title ? `${title} — ${SITE_NAME}` : `${SITE_NAME} — ${SITE_TAGLINE}`;
const canonical = new URL(path === '/' ? '/' : path, SITE_URL).href;
const ogImage = new URL('/Logo_White.png', SITE_URL).href;

const organizationLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: ORG_NAME,
  alternateName: SITE_NAME,
  url: SITE_URL,
  logo: ogImage,
  email: CONTACT_EMAIL,
  description: SITE_DESCRIPTION,
  sameAs: [SITE_URL],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#111111" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {GOOGLE_SITE_VERIFICATION && (
      <meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />
    )}

    <script type="application/ld+json" set:html={JSON.stringify(organizationLd)} />
  </head>
  <body>
    <script is:inline src="/scripts/theme-init.js"></script>
    <Ambient />
    <div class="hub">
      <SiteNav />
      <slot />
      <SiteFooter />
    </div>
    <script src="/scripts/hub-ripple.js" defer></script>
    <script src="/scripts/theme.js" defer></script>
  </body>
</html>
