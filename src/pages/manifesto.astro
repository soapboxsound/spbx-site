---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Manifesto"
  path="/manifesto"
  description="Every company deserves a workspace that is entirely their own. Client work stays inside the house that owns the relationship."
>
  <main class="page">
    <header class="page-header">
      <p class="eyebrow">Manifesto</p>
      <h1>Every company deserves a workspace that is entirely <em>their own.</em></h1>
    </header>

    <section class="page-section" style="border-top: none; margin-top: 0; padding-top: 0;">
      <p>
        Built by creatives and producers who&rsquo;ve lived the workflow from both sides of the brief.
      </p>
      <p>Talent deserves to share their identity across every room they work in.</p>
      <p>
        Every client deserves clarity and communication — not another login, not another platform.
      </p>
      <p>
        Client work stays where it belongs — inside the house that owns the relationship. The
        network never sees it.
      </p>
    </section>

    <section class="page-section">
      <p class="eyebrow">Principles</p>
      <h2>House first. Network second.</h2>
      <p>
        SPBX is a branded house workspace: your talent, your clients, your presentation — under your
        name. Privacy is structural, not a setting.
      </p>
      <div class="page-actions">
        <a class="btn btn--cta" href="/contact">Contact for access</a>
        <a class="btn btn--ghost" href="/product">Product</a>
      </div>
    </section>
  </main>
</BaseLayout>
