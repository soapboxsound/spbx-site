---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="For"
  path="/for"
  description="Built for music houses, editorial companies, and creative studios — and the talent and agency clients they serve."
>
  <main class="page">
    <header class="page-header">
      <p class="eyebrow">For</p>
      <h1>Built for houses that own the <em>relationship.</em></h1>
      <p class="page-lede">
        SPBX connects music houses, editorial companies, and creative studios with their talent and
        agency clients.
      </p>
    </header>

    <section class="page-section">
      <h2>Creative companies</h2>
      <p>
        A workspace that is entirely your own — branded presentation, project flow, and talent
        identity without putting client work on a shared marketplace.
      </p>
    </section>

    <section class="page-section">
      <h2>Talent</h2>
      <p>
        Share your identity across every room you work in — without losing the house context that
        makes the work make sense.
      </p>
    </section>

    <section class="page-section">
      <h2>Agency clients</h2>
      <p>
        Clarity and communication — not another login, not another platform. Review and feedback
        stay inside the branded house portal.
      </p>
      <div class="page-actions">
        <a class="btn btn--cta" href="/contact">Contact for access</a>
        <a class="btn btn--ghost" href="/product">Product</a>
      </div>
    </section>
  </main>
</BaseLayout>
