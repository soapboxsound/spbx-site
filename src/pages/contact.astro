---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CONTACT_EMAIL } from '../consts';
---

<BaseLayout
  title="Contact"
  path="/contact"
  description="Early access to SPBX. We’re onboarding creative companies carefully, one partner at a time."
>
  <main class="page">
    <header class="page-header">
      <p class="eyebrow">Access</p>
      <h1>Contact for <em>access</em></h1>
      <p class="page-lede">
        We&rsquo;re onboarding creative companies carefully, one partner at a time. Reach out if
        you&rsquo;d like to be considered for early access.
      </p>
    </header>

    <section class="page-section" style="border-top: none; margin-top: 0; padding-top: 0;">
      <a class="contact-email" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
      <p style="margin-top: 28px;">
        Tell us about your house — music, editorial, or creative studio — and how you work with
        talent and clients today.
      </p>
    </section>
  </main>
</BaseLayout>
