---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Product"
  path="/product"
  description="One platform for project, talent management, and client presentation — fully branded for your company."
>
  <main class="page">
    <header class="page-header">
      <p class="eyebrow">Product</p>
      <h1>One platform. Fully <em>branded</em> company.</h1>
      <p class="page-lede">
        Project, talent management, and client presentation in one place — under your brand, not
        ours.
      </p>
    </header>

    <section class="page-section">
      <div class="pillars" style="margin-top: 0;">
        <article class="pillar">
          <p class="eyebrow">Seen</p>
          <p>
            Branded client portals and presentation reels that put your company forward.
          </p>
        </article>
        <article class="pillar">
          <p class="eyebrow">Heard</p>
          <p>
            Versioned briefs, tracked submissions, and review systems built for <em>your</em> specific
            workflow.
          </p>
        </article>
        <article class="pillar">
          <p class="eyebrow">Understood</p>
          <p>
            Clear feedback loops between agencies, creative houses, and talent — no noise in between.
          </p>
        </article>
      </div>
    </section>

    <section class="page-section">
      <h2>Privacy by structure</h2>
      <p>
        Client work stays inside the house that owns the relationship. The network never sees it.
        Product hosts (tenant admin, review, talent) are separate from this marketing site and are
        not indexed here.
      </p>
      <div class="page-actions">
        <a class="btn btn--cta" href="/contact">Contact for access</a>
        <a class="btn btn--ghost" href="/for">Who it&rsquo;s for</a>
      </div>
    </section>
  </main>
</BaseLayout>
