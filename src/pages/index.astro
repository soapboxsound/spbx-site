---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_DESCRIPTION } from '../consts';
---

<BaseLayout path="/" description={SITE_DESCRIPTION}>
  <section class="hero-screen">
    <div class="hub-logo-wrap">
      <img src="/Logo_White.png" alt="SPBX" class="logo-img logo-img--dark hub-logo" />
      <img src="/Logo_Black.png" alt="SPBX" class="logo-img logo-img--light hub-logo" />
    </div>
    <h1>Be Seen.<br /><em>Be Heard.</em><br />Be Understood.</h1>
    <p class="eyebrow">Presentation &amp; creative talent network for post-production &amp; audio.</p>
    <hr class="rule" />
    <p class="hero-lede">
      SPBX connects music houses, editorial companies, and creative studios with their talent and
      agency clients.
    </p>
    <p class="hero-lede">
      One platform, fully branded company. Project, talent management and client presentation all in
      one place.
    </p>
    <div class="hero-actions">
      <a class="btn btn--cta" href="/contact">Contact for access</a>
    </div>
  </section>

  <div class="hub-body">
    <section class="hub-section" aria-labelledby="positioning-heading">
      <p class="eyebrow">Platform</p>
      <h2 id="positioning-heading">A branded house workspace — not another shared marketplace.</h2>
      <p>
        SPBX is the operating layer for creative companies: projects, talent identity, and client
        presentation under your brand.
      </p>
      <div class="page-actions">
        <a class="btn btn--ghost" href="/product">See the product</a>
        <a class="btn btn--cta" href="/for">Who it&rsquo;s for</a>
      </div>
    </section>

    <section class="hub-section" aria-labelledby="manifesto-heading">
      <p class="eyebrow">Manifesto</p>
      <h2 id="manifesto-heading">Every company deserves a workspace that is entirely their own.</h2>
      <p>
        Built by creatives and producers who&rsquo;ve lived the workflow from both sides of the brief.
      </p>
      <p>Talent deserves to share their identity across every room they work in.</p>
      <p>
        Every client deserves clarity and communication — not another login, not another platform.
      </p>
      <p>
        Client work stays where it belongs — inside the house that owns the relationship. The
        network never sees it.
      </p>
      <div class="page-actions">
        <a class="btn btn--cta" href="/manifesto">Read the manifesto</a>
      </div>
    </section>

    <section class="hub-section" aria-label="Pillars">
      <div class="pillars">
        <article class="pillar">
          <p class="eyebrow">Seen</p>
          <p>
            Branded client portals and presentation reels that put your company forward.
          </p>
        </article>
        <article class="pillar">
          <p class="eyebrow">Heard</p>
          <p>
            Versioned briefs, tracked submissions, and review systems built for <em>your</em> specific
            workflow.
          </p>
        </article>
        <article class="pillar">
          <p class="eyebrow">Understood</p>
          <p>
            Clear feedback loops between agencies, creative houses, and talent — no noise in between.
          </p>
        </article>
      </div>
    </section>

    <section class="hub-section" aria-labelledby="access-heading">
      <p class="eyebrow">Access</p>
      <h2 id="access-heading">Contact for access</h2>
      <p>
        We&rsquo;re onboarding creative companies carefully, one partner at a time. Reach out if
        you&rsquo;d like to be considered for early access.
      </p>
      <a class="contact-email" href="mailto:hi@spbx.io">hi@spbx.io</a>
      <div class="page-actions">
        <a class="btn btn--ghost" href="/contact">Contact</a>
      </div>
    </section>
  </div>
</BaseLayout>
